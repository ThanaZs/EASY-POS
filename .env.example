# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# Postgres ใดก็ได้ — Supabase: ใช้ Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# จำนวน connection ต่อ instance (serverless ใช้น้อยๆ; PGlite ทดสอบในเครื่องต้องเป็น 1)
DATABASE_POOL_MAX=5
DB_DRIVER=postgres

# Auth
AUTH_PROVIDER=better-auth
# สร้างค่าสุ่ม: npx @better-auth/cli secret  หรือ  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Google (ไม่บังคับ) — ปุ่ม Google จะแสดงเมื่อใส่ครบ 2 ค่า
# Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ไม่บังคับ — บน Vercel ไม่ต้องใส่ (ใช้โดเมน production อัตโนมัติ); ใส่เมื่อใช้โดเมนของตัวเอง
APP_URL=http://localhost:3000
